DATABASE_URL="postgresql://user@localhost:5432/skinmaster_loyalty?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# OTP provider: "console" logs OTP codes to the server log (dev default).
# Swap to a real provider (zalo_zns / esms / speedsms) once vendor credentials are available.
OTP_PROVIDER="console"
OTP_TTL_SECONDS="300"

PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
